  "keyFeatures": [
    "LLM-based log classification with structured JSON output (attack type, severity, confidence)",
    "MITRE ATT&CK tactic and technique mapping for every event",
    "P1–P5 severity triage with automatic P1/P2 agent investigation",
    "Autonomous incident investigation using tool-calling LLM loop (MITRE, AbuseIPDB, AlienVault OTX, semantic recall)",
    "Semantic vector search via Ollama embeddings + Qdrant vector database",
    "IOC extraction and enrichment (IPs, domains, hashes) with VirusTotal/AbuseIPDB links",
    "Batch log ingestion (up to 500 lines) via concurrent worker pool",
    "SSE streaming classify endpoint for token-by-token LLM output",
    "Live WebSocket incident stream with real-time alert ticker",
    "React 19 dashboard with analytics charts, MITRE heatmap, and threat intel panel",
    "Prometheus metrics and Swagger UI built in",
    "CLI mode for offline log file analysis"
  ],
  "publicApiSurface": [
